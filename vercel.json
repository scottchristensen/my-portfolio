{
  "redirects": [
    {
      "source": "/work/egencia-self-service/:path*",
      "destination": "/work/expedia-self-service/:path*",
      "permanent": true
    },
    {
      "source": "/work/egencia-self-service",
      "destination": "/work/expedia-self-service/",
      "permanent": true
    },
    {
      "source": "/documents/Scott_Christensen_CV_5.18.23-compressed.pdf",
      "destination": "/documents/Scott_Christensen_CV.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/advisory(\\.html|\\.md)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
